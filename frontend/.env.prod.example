# ─── URLS ───
VITE_API_URL=https://api.alkher-academy.com/api
VITE_SOCKET_URL=https://api.alkher-academy.com

# ─── BACKEND ───
NODE_ENV=production
PORT=4000
BASE_URL=https://api.alkher-academy.com
CLIENT_URL=https://alkher-academy.com
JWT_SECRET=CHANGE_ME_USE_OPENSSL_rand_-hex_32
JWT_EXPIRES_IN=7d
CERT_SECRET=CHANGE_ME_TOO_OPENSSL_rand_-hex_32
DB_PATH=/app/data/alkher.db
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=5

# ─── ALKHERPAY ───
ALKHERPAY_API_KEY=your_production_key
ALKHERPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── EMAIL ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@alkher-academy.com
SMTP_PASS=your_app_password
SMTP_FROM="ALKHER ACADEMY <noreply@alkher-academy.com>"

# ─── SEED (premier lancement seulement) ───
SEED_ADMIN_EMAIL=admin@alkher-academy.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD