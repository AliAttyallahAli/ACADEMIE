# ─── APP ───
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# ─── SÉCURITÉ ───
JWT_SECRET=change_me_please_use_a_long_random_string
JWT_EXPIRES_IN=7d
CERT_SECRET=change_me_too_for_hmac_certificates

# ─── BASE DE DONNÉES ───
DB_PATH=./data/alkher.db

# ─── ALKHERPAY ───

ALKHERPAY_API_KEY=http://localhost:5000
ALKHERPAY_WEBHOOK_SECRET=http://localhost:5000

# ─── EMAIL (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ALKHER ACADEMY <no-reply@alkher-academy.com>"

# ─── UPLOADS ───
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5